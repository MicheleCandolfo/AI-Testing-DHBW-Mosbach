# ── DeepEval / Confident AI ──────────────────────────────
# Get your key from: https://app.confident-ai.com
CONFIDENT_API_KEY=confident_us_...
API_KEY=confident_us_...

# ── Ollama (lokal) ───────────────────────────────────────
LOCAL_MODEL_BASE_URL=http://localhost:11434
LOCAL_MODEL_API_KEY=ollama
LOCAL_MODEL_NAME=qwen3:latest
USE_LOCAL_MODEL=1

# ── Ollama (Cloud / Remote) ──────────────────────────────
# Falls ihr einen Cloud-Ollama-Server nutzt, tragt hier die URL und den API-Key ein:
CLOUD_MODEL_BASE_URL=https://euer-ollama-server.example.com
OLLAMA_API_KEY=euer-ollama-api-key

# ── Embedding-Modelle ────────────────────────────────────
USE_LOCAL_EMBEDDINGS=0
LOCAL_EMBEDDING_MODEL_NAME=qwen3-embedding:latest
LOCAL_EMBEDDING_BASE_URL=http://localhost:11434
LOCAL_EMBEDDING_API_KEY=ollama

# ── Cloud-Provider (optional) ────────────────────────────
# Nur benötigt, wenn ihr OpenAI-Embeddings nutzt (Notebook 02):
OPENAI_API_KEY=sk-...
USE_OPENAI_MODEL=0
USE_GEMINI_MODEL=0
USE_AZURE_OPENAI=0

# ── DeepEval Timeouts ────────────────────────────────────
DEEPEVAL_PER_TASK_TIMEOUT_SECONDS_OVERRIDE=600
DEEPEVAL_PER_ATTEMPT_TIMEOUT_SECONDS_OVERRIDE=180
DEEPEVAL_RETRY_MAX_ATTEMPTS=2
DEEPEVAL_VERBOSE_MODE=1
LOG_LEVEL=DEBUG